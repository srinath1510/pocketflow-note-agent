NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password_here
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_PROVIDER=anthropic

NOTION_TOKEN=your_notion_integration_token_here

# Optional: Specific database ID to use (otherwise creates new ones)
# NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: Parent page ID for creating databases (otherwise uses workspace root)
NOTION_PARENT_PAGE_ID=your_page_id_here

# Batch processing configuration
BATCH_SIZE=5                    # Captures per LLM call (default: 5)
MIN_CONTENT_LENGTH=100         # Skip LLM for short content
ENABLE_CONTENT_CACHE=true     # Cache analysis results